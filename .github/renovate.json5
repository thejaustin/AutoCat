{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:recommended',
    ],
    labels: [
        'dependencies',
    ],
    packageRules: [
        // Enable auto-merge for minor/patch updates.
        {
            matchUpdateTypes: [
                'minor',
                'patch',
            ],
            automerge: true,
        },
        // KSP 2.3.13 randomly drops generated code: https://github.com/google/ksp/issues/3286
        {
            matchPackageNames: [
                'com.google.devtools.ksp',
            ],
            allowedVersions: '!/^2\\.3\\.13$/',
        },
    ],
}
